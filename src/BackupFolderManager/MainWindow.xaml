<Window x:Class="BackupFolderManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Folder Manager" Height="800" Width="1060" MinHeight="650" MinWidth="850">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <DockPanel>
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="フォルダ選択・追加" Padding="12,6" Click="Browse_Click"/>
                <Button x:Name="AddButton" DockPanel.Dock="Right" Content="パスを追加" Padding="12,6" Margin="6,0" Click="Add_Click"/>
                <TextBox x:Name="RootPath" VerticalContentAlignment="Center" ToolTip="未接続のドライブのパスも登録できます"/>
            </DockPanel>
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="圧縮対象の階層:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="TargetDepth" SelectedIndex="0" Width="160" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="直下のフォルダ"/>
                    <ComboBoxItem Content="孫フォルダ"/>
                </ComboBox>
                <Button x:Name="ApplyDepthButton" Content="選択した登録に適用" Padding="12,6" Margin="8,0" Click="ApplyDepth_Click"/>
                <TextBlock Text="新規登録にもこの階層を使用します" VerticalAlignment="Center"/>
            </WrapPanel>
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="RemoveButton" DockPanel.Dock="Right" Content="登録解除" Padding="12,6" Margin="8,0,0,0" Click="Remove_Click"/>
                <ListView x:Name="Roots" Height="110" SelectionMode="Extended">
                    <ListView.View><GridView>
                        <GridViewColumn Header="登録した親フォルダ（一括アーカイブは選択行が対象）" DisplayMemberBinding="{Binding Path}" Width="450"/>
                        <GridViewColumn Header="対象階層" DisplayMemberBinding="{Binding TargetDescription}" Width="120"/>
                        <GridViewColumn Header="状態" DisplayMemberBinding="{Binding Status}" Width="150"/>
                    </GridView></ListView.View>
                </ListView>
            </DockPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="上のボタンは登録ごとの対象階層で一括アーカイブします。保存先は各対象フォルダの隣です。下のボタンは一覧の選択行を展開／圧縮します。" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="BackupButton" Content="選択フォルダをアーカイブ" ToolTip="上の登録一覧の選択行を、設定した対象階層で処理します" Padding="16,6" Click="Backup_Click"/>
                <CheckBox x:Name="DeleteSource" IsChecked="True" Content="検証後に元フォルダの中身を削除する" VerticalAlignment="Center" Margin="16,0"/>
                <Button x:Name="RefreshButton" Content="一覧更新" Padding="16,6" Click="Refresh_Click"/>
            </WrapPanel>
        </StackPanel>
        <ListView x:Name="Folders" Grid.Row="2" SelectionMode="Extended">
            <ListView.View><GridView>
                <GridViewColumn Header="フォルダ名" DisplayMemberBinding="{Binding Name}" Width="190"/>
                <GridViewColumn Header="状態" DisplayMemberBinding="{Binding State}" Width="270"/>
                <GridViewColumn Header="親フォルダ" DisplayMemberBinding="{Binding Parent}" Width="270"/>
                <GridViewColumn Header="アーカイブ (.7z / .zip)" DisplayMemberBinding="{Binding Archives}" Width="230"/>
            </GridView></ListView.View>
        </ListView>
        <DockPanel Grid.Row="3" Margin="0,12">
            <Button x:Name="ExtractButton" Content="選択フォルダを展開／圧縮" ToolTip="下の一覧の選択行が対象。展開後はフォルダを開きます。" Padding="16,6" Click="Extract_Click" DockPanel.Dock="Left"/>
            <TextBlock x:Name="Status" Text="待機中" Margin="16,0" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="Log" Grid.Row="4" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    </Grid>
</Window>
